From 9cb99d4fa3358c1834c88e64fc09702a44d4f8d8 Mon Sep 17 00:00:00 2001
From: ChatGPT Assistant <chatgpt@local.invalid>
Date: Thu, 5 Nov 2026 20:25:06 +0000
Subject: [PATCH 2/5] render: preserve original font-cell spacing and row
 clearing

---
 config.def.h |  8 +++++---
 x.c          | 17 ++++++++++-------
 2 files changed, 15 insertions(+), 10 deletions(-)

diff --git a/config.def.h b/config.def.h
index 0b13b86..35fa43b 100644
--- a/config.def.h
+++ b/config.def.h
@@ -25,9 +25,11 @@ char *stty_args = "stty raw pass8 nl -echo -iexten -cstopb 38400";
 /* identification sequence returned in DA and DECID */
 char *vtiden = "\033[?6c";
 
-/* Kerning / character bounding-box multipliers */
-static float cwscale = 1.0;
-static float chscale = 1.0;
+/* Extra pixels on each side of the font's cell. The vertical margin is
+ * also used to clear the custom cursor's overhanging horizontal strokes.
+ * Keep these integer offsets for the fork's original pixel geometry. */
+static int add_x_space = 0;
+static int add_y_space = 1;
 
 /*
  * word delimiter string
diff --git a/x.c b/x.c
index 76f572d..c3eee89 100644
--- a/x.c
+++ b/x.c
@@ -1029,8 +1029,8 @@ xloadfonts(const char *fontstr, double fontsize)
 	}
 
 	/* Setting character width and height. */
-	win.cw = ceilf(dc.font.width * cwscale);
-	win.ch = ceilf(dc.font.height * chscale);
+	win.cw = ceilf(dc.font.width + (2 * add_x_space));
+	win.ch = ceilf(dc.font.height + (2 * add_y_space));
 
 	FcPatternDel(pattern, FC_SLANT);
 	FcPatternAddInteger(pattern, FC_SLANT, FC_SLANT_ITALIC);
@@ -1258,7 +1258,7 @@ xmakeglyphfontspecs(XftGlyphFontSpec *specs, const Glyph *glyphs, int len, int x
 	FcCharSet *fccharset;
 	int i, f, numspecs = 0;
 
-	for (i = 0, xp = winx, yp = winy + font->ascent; i < len; ++i) {
+	for (i = 0, xp = winx + add_x_space, yp = winy + font->ascent; i < len; ++i) {
 		/* Fetch rune and mode for current glyph. */
 		rune = glyphs[i].u;
 		mode = glyphs[i].mode;
@@ -1481,8 +1481,11 @@ xdrawglyphfontspecs(const XftGlyphFontSpec *specs, Glyph base, int len, int x, i
 	if (winy + win.ch >= borderpx + win.th)
 		xclear(winx, winy + win.ch, winx + width, win.h);
 
-	/* Clean up the region we want to draw to. */
-	XftDrawRect(xw.draw, bg, winx, winy, width, win.ch);
+	/* Clear one extra margin above and below: the extended cursor draws
+	 * over these margins, so redrawing a row must erase its old strokes. */
+	XftDrawRect(xw.draw, bg, winx - add_x_space,
+			winy - add_y_space, width + 2 * add_x_space,
+			win.ch + 2 * add_y_space);
 
 	/* Set the clip region because Xft is sometimes dirty. */
 	r.x = 0;
@@ -1496,12 +1499,12 @@ xdrawglyphfontspecs(const XftGlyphFontSpec *specs, Glyph base, int len, int x, i
 
 	/* Render underline and strikethrough. */
 	if (base.mode & ATTR_UNDERLINE) {
-		XftDrawRect(xw.draw, fg, winx, winy + dc.font.ascent * chscale + 1,
+		XftDrawRect(xw.draw, fg, winx, winy + dc.font.ascent + 1,
 				width, 1);
 	}
 
 	if (base.mode & ATTR_STRUCK) {
-		XftDrawRect(xw.draw, fg, winx, winy + 2 * dc.font.ascent * chscale / 3,
+		XftDrawRect(xw.draw, fg, winx, winy + 2 * dc.font.ascent / 3,
 				width, 1);
 	}
 
